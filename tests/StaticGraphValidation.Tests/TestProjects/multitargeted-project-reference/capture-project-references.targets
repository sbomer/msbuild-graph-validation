<Project>
  <PropertyGroup>
    <_ProjectReferenceCaptureMetadata>CaptureParentProject;CaptureParentTargetFramework;CaptureReferencedProject;CaptureSetTargetFramework</_ProjectReferenceCaptureMetadata>
    <_GraphValidationRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', '..'))</_GraphValidationRepoRoot>
    <StaticGraphTasksAssemblyPath Condition="'$(StaticGraphTasksAssemblyPath)' == ''">$([MSBuild]::NormalizePath('$(_GraphValidationRepoRoot)', 'artifacts', 'bin', 'StaticGraphTasks', 'debug', 'StaticGraphTasks.dll'))</StaticGraphTasksAssemblyPath>
  </PropertyGroup>

  <UsingTask TaskName="MSBuild.GraphValidation.Tasks.DeduplicateProjectReferenceCapture"
             AssemblyFile="$(StaticGraphTasksAssemblyPath)"
             Condition="'$(StaticGraphTasksAssemblyPath)' != '' and Exists('$(StaticGraphTasksAssemblyPath)')" />

  <Target Name="CaptureProjectReferencesRecursive"
          DependsOnTargets="_CaptureProjectReferencesRecursive"
          Condition="'$(CaptureProjectReferences)' == 'true' and '$(CaptureProjectReferencesFile)' != ''"
          Returns="@(_CapturedProjectReferenceResult)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(CaptureProjectReferencesFile)'))" />
    <WriteLinesToFile File="$(CaptureProjectReferencesFile)"
                      Lines="@(_CapturedProjectReferenceResult->'%(CaptureParentProject)|%(CaptureParentTargetFramework)|%(CaptureReferencedProject)|%(CaptureSetTargetFramework)')"
                      Overwrite="true" />
  </Target>

  <Target Name="_CaptureProjectReferencesRecursive"
          DependsOnTargets="_CaptureProjectReferencesOuterBuild;_CaptureProjectReferencesInnerBuild;_DeduplicateCapturedProjectReferences"
          Returns="@(_CapturedProjectReferenceResult)" />

  <Target Name="_CaptureProjectReferencesOuterBuild"
          Condition="'$(IsCrossTargetingBuild)' == 'true'">
    <ItemGroup>
      <_CaptureTargetFramework Include="$(TargetFrameworks)" />
    </ItemGroup>

    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="_CaptureProjectReferencesRecursive"
             Properties="TargetFramework=%(_CaptureTargetFramework.Identity);CaptureProjectReferences=true;CaptureProjectReferencesTargets=$(CaptureProjectReferencesTargets);StaticGraphTasksAssemblyPath=$(StaticGraphTasksAssemblyPath)"
             RemoveProperties="TargetFrameworks"
             BuildInParallel="$(BuildInParallel)"
             SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs"
              ItemName="_CapturedProjectReferenceResult" />
    </MSBuild>
  </Target>

  <Target Name="_CaptureProjectReferencesInnerBuild"
          DependsOnTargets="PrepareProjectReferences;_GetProjectReferenceTargetFrameworkProperties"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <ItemGroup>
      <_CapturedProjectReference Include="@(_MSBuildProjectReferenceExistent)">
        <CaptureParentProject>$(MSBuildProjectFullPath)</CaptureParentProject>
        <CaptureParentTargetFramework>$(TargetFramework)</CaptureParentTargetFramework>
        <CaptureReferencedProject>%(_MSBuildProjectReferenceExistent.FullPath)</CaptureReferencedProject>
        <CaptureSetTargetFramework>%(_MSBuildProjectReferenceExistent.SetTargetFramework)</CaptureSetTargetFramework>
      </_CapturedProjectReference>

      <_CapturedProjectReferenceResult Include="@(_CapturedProjectReference)"
                                       KeepMetadata="$(_ProjectReferenceCaptureMetadata)" />
    </ItemGroup>

    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="_CaptureProjectReferencesRecursive"
             Properties="%(_MSBuildProjectReferenceExistent.SetTargetFramework);%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);CaptureProjectReferences=true;CaptureProjectReferencesTargets=$(CaptureProjectReferencesTargets);StaticGraphTasksAssemblyPath=$(StaticGraphTasksAssemblyPath)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);%(_MSBuildProjectReferenceExistent.UndefineProperties);$(_GlobalPropertiesToRemoveFromProjectReferences)"
             BuildInParallel="$(BuildInParallel)"
             SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs"
              ItemName="_CapturedProjectReferenceResult" />
    </MSBuild>
  </Target>

  <Target Name="_DeduplicateCapturedProjectReferences">
    <MSBuild.GraphValidation.Tasks.DeduplicateProjectReferenceCapture Items="@(_CapturedProjectReferenceResult)"
                                                                      Condition="'@(_CapturedProjectReferenceResult)' != '' and '$(StaticGraphTasksAssemblyPath)' != '' and Exists('$(StaticGraphTasksAssemblyPath)')">
      <Output TaskParameter="UniqueItems"
              ItemName="_UniqueCapturedProjectReferenceResult" />
    </MSBuild.GraphValidation.Tasks.DeduplicateProjectReferenceCapture>

    <ItemGroup Condition="'@(_UniqueCapturedProjectReferenceResult)' != ''">
      <_CapturedProjectReferenceResult Remove="@(_CapturedProjectReferenceResult)" />
      <_CapturedProjectReferenceResult Include="@(_UniqueCapturedProjectReferenceResult)"
                                       KeepMetadata="$(_ProjectReferenceCaptureMetadata)" />
      <_UniqueCapturedProjectReferenceResult Remove="@(_UniqueCapturedProjectReferenceResult)" />
    </ItemGroup>

    <Message Importance="High"
             Text="CaptureProjectReferencesCount Project=$(MSBuildProjectFullPath) TargetFramework=$(TargetFramework) Count=@(_CapturedProjectReferenceResult->Count())"
             Condition="'$(CaptureProjectReferencesLogCounts)' == 'true'" />
  </Target>
</Project>
